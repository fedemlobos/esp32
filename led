#define boton 34
#define led 23
uint8_t estado_boton=0, estado_led=0;

void setup() {
  pinMode(boton, INPUT);
  pinMode(led, OUTPUT);

  // configurar pines / variables:
  Serial.begin(115200);
  Serial.println("Que onda??");
}

void loop() {
//lectura e impresion del estado del boton
 estado_boton = digitalRead(boton);
 Serial.print(estado_boton);

if (estado_boton==1){

  if (estado_led==0){
    estado_led=1;
  }
  else {
    estado_led=0;
  }


}

//Hecho por profe
//encendido o apagado del led
 digitalWrite(led,estado_led);
  delay(100); // this speeds up the simulation
}
